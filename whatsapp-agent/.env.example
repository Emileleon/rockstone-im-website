# AgentKit — Variables d'environnement (ROCKSTONE IM)
# Copiez ce fichier en .env et remplissez vos valeurs :
#   cp .env.example .env
# NE JAMAIS commiter le fichier .env.

# ── API Anthropic ─────────────────────────────────────────
# À obtenir sur : https://platform.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=
# Modèle Claude utilisé par l'agent (par défaut : claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# ── Fournisseur WhatsApp ──────────────────────────────────
# Options : meta | twilio  (twilio = le plus rapide pour démarrer, sandbox gratuit)
WHATSAPP_PROVIDER=

# ── Meta Cloud API (si WHATSAPP_PROVIDER=meta) ────────────
# À configurer sur : https://developers.facebook.com
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=agentkit-verify

# ── Twilio (si WHATSAPP_PROVIDER=twilio) ──────────────────
# À configurer sur : https://twilio.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Serveur ───────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Relances proactives (prospect silencieux) ─────────────
# 1ère relance après X minutes, 2ème relance après Y heures, nb total max.
RELANCE_1_MINUTES=30
RELANCE_2_HORAS=24
MAX_RELANCES=2
# Fréquence de scan des relances dues (secondes)
SEGUIMIENTO_INTERVALO_SEGUNDOS=60

# ── Base de données ───────────────────────────────────────
# Local (SQLite) :
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Production (PostgreSQL sur Railway) :
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
